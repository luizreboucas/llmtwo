{
  "expo": {
    "name": "llmtwo",
    "slug": "llmtwo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "llmtwo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.llmtwo"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [ 
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir $(PRODUCT_NAME) acessar sua câmera",
          "microphonePermission": "Permitir $(PRODUCT_NAME) acessar seu microfone",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Righteous-Regular.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Righteous",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Righteous-Regular.ttf",
                    "weight": 400,
                    "style": "normal"
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": ["./assets/fonts/Righteous-Regular.ttf"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
